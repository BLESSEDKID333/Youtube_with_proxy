#!/usr/bin/env python3
import sys
import os
import json
import subprocess
import tempfile
import re
import uuid
from urllib.parse import urlparse, urlencode, parse_qs, quote

def detect_vps_base():
    """Detect VPS base URL from request headers"""
    scheme = os.environ.get("HTTPS", "") == "on" and "https" or "http"
    host = os.environ.get("HTTP_HOST", "") or os.environ.get("SERVER_NAME", "localhost")
    if ":" in host:
        host = host.split(":")[0]
    port = os.environ.get("SERVER_PORT", "80")
    vps_base = os.environ.get("VPS_BASE", "").rstrip("/")
    if not vps_base:
        if port and port not in ("80", "443"):
            vps_base = f"{scheme}://{host}:{port}"
        else:
            vps_base = f"{scheme}://{host}"
    return vps_base

VPS_BASE = detect_vps_base()

def send_json(data):
    sys.stdout.write("Content-Type: application/json; charset=utf-8\n")
    sys.stdout.write("Access-Control-Allow-Origin: *\n")
    sys.stdout.write("Cache-Control: no-cache, no-store\n")
    sys.stdout.write("\n")
    sys.stdout.write(json.dumps(data))
    sys.stdout.flush()

def rewrite_url(original_url, vps_base):
    """Rewrite googlevideo.com URL to go through VPS proxy"""
    parsed = urlparse(original_url)
    if not parsed.scheme:
        return original_url
    host = parsed.netloc
    path = parsed.path
    query = parsed.query
    proxied = f"{vps_base}/ytproxy/{host}{path}"
    if query:
        proxied += f"?{query}"
    return proxied

def extract_with_ytdlp(video_id):
    """Use yt-dlp to get the best video URL"""
    try:
        result = subprocess.run(
            ["/usr/local/bin/yt-dlp",
             "--no-warnings",
             "--no-playlist",
             "--socket-timeout", "10",
             "--proxy", "socks5://127.0.0.1:40000",
             "-f", "b/best/mp4",
             "--dump-json",
             f"https://www.youtube.com/watch?v={video_id}"],
            capture_output=True,
            timeout=25,
            text=True
        )
        if result.returncode != 0:
            stderr = result.stderr.strip()
            if not stderr:
                return {"error": "yt-dlp failed"}
            return {"error": stderr[:300]}

        try:
            data = json.loads(result.stdout)
        except Exception:
            return {"error": "Failed to parse yt-dlp json"}

        direct_url = data.get("url")
        if not direct_url:
            return {"error": "No URL extracted"}

        quality = data.get("format_note", "unknown")
        codec = data.get("vcodec", "unknown")

        return {
            "url": rewrite_url(direct_url, VPS_BASE),
            "quality": quality,
            "codec": codec
        }
    except subprocess.TimeoutExpired:
        return {"error": "yt-dlp timed out"}
    except FileNotFoundError:
        return {"error": "yt-dlp not installed"}
    except Exception as e:
        return {"error": str(e)[:300]}

if __name__ == "__main__":
    method = os.environ.get("REQUEST_METHOD", "GET")
    query = os.environ.get("QUERY_STRING", "")
    params = parse_qs(query)

    if method != "GET":
        send_json({"error": "Only GET supported"})
        sys.exit(0)

    video_id = params.get("videoId", [None])[0]
    if not video_id:
        send_json({"error": "Missing videoId parameter"})
        sys.exit(0)

    result = extract_with_ytdlp(video_id)
    send_json(result)
