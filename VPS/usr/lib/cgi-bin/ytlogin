import json
import http.cookies
from urllib.parse import quote, quote_plus

def detect_vps_base():
    """Detect VPS base URL from request headers"""
    scheme = os.environ.get("HTTPS", "") == "on" and "https" or "http"
    host = os.environ.get("HTTP_HOST", "") or os.environ.get("SERVER_NAME", "localhost")
    port = os.environ.get("SERVER_PORT", "80")
    vps_base = os.environ.get("VPS_BASE", "").rstrip("/")
    if not vps_base:
        if port and port not in ("80", "443"):
            if ":" in host:
                vps_base = f"{scheme}://{host}"
            else:
                vps_base = f"{scheme}://{host}:{port}"
        else:
            vps_base = f"{scheme}://{host}"
    return vps_base

VPS_BASE = detect_vps_base()

def send_html(body):
    print("Content-Type: text/html; charset=utf-8")
    print("Cache-Control: no-cache, no-store")
    print()
    print(body)

def send_json(data):
    print("Content-Type: application/json; charset=utf-8")
    print("Cache-Control: no-cache, no-store")
    print()
    print(json.dumps(data))

def parse_request_cookies():
    cookie_str = os.environ.get("HTTP_COOKIE", "")
    result = {"sapisid": None, "hsid": None, "ssid": None, "apisid": None}
    if not cookie_str:
        return result
    try:
        cookie = http.cookies.SimpleCookie()
        cookie.load(cookie_str)
        
        # Check standard and secure variations of Google/YouTube login cookies
        for name in ["SAPISID", "HSID", "SSID", "APISID"]:
            if name in cookie:
                result[name.lower()] = cookie[name].value
            elif f"__Secure-3P{name}" in cookie:
                result[name.lower()] = cookie[f"__Secure-3P{name}"].value
    except Exception as e:
        pass
    return result

def save_device_cookies(device_id, cookies):
    path = f"/tmp/yt_cookies_{device_id}.json"
    try:
        with open(path, "w") as f:
            json.dump(cookies, f)
    except:
        pass

def get_device_cookies(device_id):
    path = f"/tmp/yt_cookies_{device_id}.json"
    if os.path.exists(path):
        try:
            with open(path) as f:
                return json.load(f)
        except:
            pass
    return None

