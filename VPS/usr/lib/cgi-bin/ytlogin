def main():
    form = cgi.FieldStorage()
    device_id = form.getvalue("device")
    action = form.getvalue("action")
    method = os.environ.get("REQUEST_METHOD", "GET")

    if not device_id:
        send_json({"error": "Missing device parameter"})
        return

    # 1. Action: Check status (AJAX polling from iOS 6)
    if action == "check":
        cookies = get_device_cookies(device_id)
        if cookies and cookies.get("sapisid"):
            token = f"{cookies['sapisid']}:{cookies.get('hsid') or ''}:{cookies.get('ssid') or ''}:{cookies.get('apisid') or ''}"
            send_json({"status": "success", "token": token})
        else:
            send_json({"status": "waiting"})
        return

    # 2. Action: Remote browser activation
    if action == "remote":
        # Check if browser already has Google cookies
        browser_cookies = parse_request_cookies()
        has_sapisid = browser_cookies.get("sapisid") is not None
        
        if method == "POST" and has_sapisid:
            # Save cookies to device file
            save_device_cookies(device_id, browser_cookies)
            render_success_page()
        else:
            render_remote_login_page(device_id, has_sapisid)
        return

    # 3. Default iOS 6 app request
    # If already logged in, redirect directly to success scheme
    cookies = get_device_cookies(device_id)
    if cookies and cookies.get("sapisid"):
        token = f"{cookies['sapisid']}:{cookies.get('hsid') or ''}:{cookies.get('ssid') or ''}:{cookies.get('apisid') or ''}"
        print(f"Status: 302 Found")
        print(f"Location: ytlogin://success?token={token}")
        print()
        return

    # Otherwise render pairing page
    remote_url = f"{VPS_BASE}/cgi-bin/ytlogin?device={device_id}&action=remote"
    render_ios_pairing_page(device_id, remote_url)

if __name__ == "__main__":
    main()
